@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutKiosk";
}

<!-- Main Container -->
<div class="min-vh-100 d-flex flex-column justify-content-center align-items-center bg-gradient-light p-4">

    <!-- Login Card -->
    <div class="card border-0 shadow-lg" style="width: 100%; max-width: 400px; border-radius: 20px;">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="text-center mb-5">
                <div class="bg-primary rounded-circle d-inline-flex p-3 mb-4">
                    <i class="fas fa-user-md text-white" style="font-size: 2.5rem;"></i>
                </div>
                <h2 class="fw-bold text-primary">Hospital Queue System</h2>
            </div>

            <!-- Login Form -->
            <form method="post" asp-controller="Auth" asp-action="Login" id="loginForm">
                <div class="mb-4">
                    <label class="form-label fw-semibold">Username or Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-user text-muted"></i>
                        </span>
                        <!-- ADDED value attribute -->
                        <input type="text" name="usernameOrEmail" class="form-control border-start-0"
                               value="@ViewBag.UsernameOrEmail"
                               placeholder="Enter your username or email" required autofocus>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-lock text-muted"></i>
                        </span>
                        <input type="password" name="password" class="form-control border-start-0"
                               placeholder="Enter your password" required>
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" id="loginBtn" class="btn btn-primary btn-lg fw-semibold py-3">
                        <span class="btn-text">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </span>
                        <span class="btn-spinner d-none">
                            <i class="fas fa-spinner fa-spin me-2"></i>Logging in...
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Back -->
    <div class="mt-4 text-center">
        <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-primary">
            <i class="fas fa-arrow-left me-1"></i>Back to Check-In
        </a>
    </div>
</div>


<!-- Scripts -->
<script>
    const form = document.getElementById("loginForm");
    const btn = document.getElementById("loginBtn");
    const text = btn.querySelector(".btn-text");
    const spinner = btn.querySelector(".btn-spinner");

    form.addEventListener("submit", () => {
        btn.classList.add("btn-disabled");
        text.classList.add("d-none");
        spinner.classList.remove("d-none");
    });
</script>

<style>
    /* Custom styles for Login Page */
.bg-gradient-light {
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
}

.card {
  transition: transform 0.3s ease;
}

.card:hover {
  transform: translateY(-5px);
}

.input-group-text {
  border-radius: 10px 0 0 10px;
  border-right: none;
}

.form-control {
  border-radius: 0 10px 10px 0;
  border-left: none;
  padding: 12px 15px;
}

/* Button disabled state - FIXED with !important */
.btn-disabled {
  opacity: 0.6 !important;
  cursor: not-allowed !important;
  pointer-events: none !important;
}


</style>