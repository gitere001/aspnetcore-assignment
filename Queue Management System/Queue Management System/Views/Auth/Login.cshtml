@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutKiosk";
}

<!-- Main Container -->
<div class="min-vh-100 d-flex flex-column justify-content-center align-items-center bg-gradient-light p-4">

    <!-- Login Card -->
    <div class="card border-0 shadow-lg" style="width: 100%; max-width: 400px; border-radius: 20px;">
        <div class="card-body p-5">

            <!-- Header -->
            <div class="text-center mb-5">
                <div class="bg-primary rounded-circle d-inline-flex p-3 mb-4">
                    <i class="fas fa-user-md text-white" style="font-size: 2.5rem;"></i>
                </div>
                <h2 class="fw-bold text-primary">Hospital Queue System</h2>
            </div>

            <!-- Error Message -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Login Form -->
            <form method="post" asp-controller="Auth" asp-action="Login">
                <div class="mb-4">
                    <label for="username" class="form-label fw-semibold">Username or Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-user text-muted"></i>
                        </span>
                        <input type="text" id="username" name="usernameOrEmail" class="form-control border-start-0"
                               placeholder="Enter your username or email" required autofocus>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-lock text-muted"></i>
                        </span>
                        <input type="password" id="password" name="password" class="form-control border-start-0"
                               placeholder="Enter your password" required>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg fw-semibold py-3">
                        <i class="fas fa-sign-in-alt me-2"></i>Login
                    </button>
                </div>
            </form>

            <!-- Footer -->
            <div class="text-center mt-4 pt-3 border-top">
                <p class="text-muted small mb-0">
                    <i class="fas fa-shield-alt me-1"></i>Secure access for authorized personnel only
                </p>
            </div>
        </div>
    </div>

    <!-- Back to Home -->
    <div class="mt-4 text-center">
        <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-primary">
            <i class="fas fa-arrow-left me-1"></i>Back to Check-In
        </a>
    </div>
</div>

<!-- Styles -->
<style>
    .bg-gradient-light {
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
    }

    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .input-group-text {
        border-radius: 10px 0 0 10px;
        border-right: none;
    }

    .form-control {
        border-radius: 0 10px 10px 0;
        border-left: none;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
        border-color: #86b7fe;
    }

    .btn-primary {
        background: linear-gradient(to right, #4a6cf7, #6a82fb);
        border: none;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: linear-gradient(to right, #3a5ce5, #5a72e9);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(74, 108, 247, 0.3);
    }
</style>
