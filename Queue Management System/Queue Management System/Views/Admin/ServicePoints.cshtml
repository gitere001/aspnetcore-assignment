@model List<Queue_Management_System.Models.ServicePoint>

@{
    ViewData["Title"] = "Service Points";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Service Points Management</h1>
            <p class="text-muted mb-0">Manage physical service counters and stations</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addServicePointModal">
            <i class="fas fa-plus-circle me-2"></i>Add Service Point
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Service Points
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-store fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Active Points
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(sp => sp.IsActive)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Services Covered
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Select(sp => sp.ServiceId).Distinct().Count()
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-concierge-bell fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Inactive Points
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(sp => !sp.IsActive)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-ban fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Service Points Table -->
    <div class="card shadow">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">All Service Points</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="servicePointsTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Point Name</th>
                            <th>Service</th>
                            <th>Prefix</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in Model)
                        {
                            <tr>
                                <td>@point.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="symbol symbol-40px me-3">
                                            <div class="symbol-label bg-light-primary">
                                                <span class="text-primary fw-bold">@point.Name.Substring(0, 1)</span>
                                            </div>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@point.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold">@point.ServiceName</div>
                                </td>
                                <td>
                                    <span class="badge bg-dark">
                                        @point.ServicePrefix
                                    </span>
                                </td>
                                <td>
                                    @if (point.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @point.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-sm btn-outline-primary edit-service-point-btn" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger delete-service-point-btn" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="fas fa-store fa-3x mb-3"></i>
                                        <p>No service points found. Add your first service point!</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Service Point Modal -->
<div class="modal fade" id="addServicePointModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Service Point</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addServicePointForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div id="servicePointFormError" class="alert alert-danger d-none"></div>
                    <div id="servicePointFormSuccess" class="alert alert-success d-none"></div>

                    <div class="mb-3">
                        <label for="servicePointName" class="form-label">Service Point Name *</label>
                        <input type="text" class="form-control" id="servicePointName" name="name" required
                               placeholder="e.g., Doctor Counter 1, Lab Window, Pharmacy Desk">
                        <div class="form-text">Enter a descriptive name for the physical counter</div>
                    </div>

                    <div class="mb-3">
                        <label for="serviceId" class="form-label">Service *</label>
                        <select class="form-select" id="serviceId" name="serviceId" required>
                            <option value="" selected disabled>Loading services...</option>
                        </select>
                        <div class="form-text">Which service will be handled at this counter?</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="isActive" name="isActive" checked>
                        <label class="form-check-label" for="isActive">Active</label>
                        <div class="form-text">Inactive service points won't receive new tickets</div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submitServicePointBtn">Add Service Point</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteServicePointModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-5">
                <i class="fas fa-exclamation-triangle text-danger mb-3" style="font-size: 3rem;"></i>
                <h4>Delete Service Point</h4>
                <p class="text-muted">Delete confirmation will be implemented here</p>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" disabled>Delete Service Point</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Service Point Modal -->
<div class="modal fade" id="editServicePointModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Service Point</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editServicePointForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editServicePointId" name="id">
                <div class="modal-body">
                    <div id="editServicePointFormError" class="alert alert-danger d-none"></div>
                    <div id="editServicePointFormSuccess" class="alert alert-success d-none"></div>

                    <div class="mb-3">
                        <label for="editServicePointName" class="form-label">Service Point Name *</label>
                        <input type="text" class="form-control" id="editServicePointName" name="name" required
                               placeholder="e.g., Doctor Counter 1, Lab Window, Pharmacy Desk">
                        <div class="form-text">Enter a descriptive name for the physical counter</div>
                    </div>

                    <div class="mb-3">
                        <label for="editServiceId" class="form-label">Service *</label>
                        <select class="form-select" id="editServiceId" name="serviceId" required>
                            <option value="" selected disabled>Loading services...</option>
                        </select>
                        <div class="form-text">Which service will be handled at this counter?</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="editIsActive" name="isActive">
                        <label class="form-check-label" for="editIsActive">Active</label>
                        <div class="form-text">Inactive service points won't receive new tickets</div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submitEditServicePointBtn">Update Service
                        Point</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Same styles as Services.cshtml -->
    <style>
        .symbol {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.475rem;
        }

        .symbol-40px {
            width: 40px;
            height: 40px;
        }

        .symbol-label {
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: var(--bs-primary);
            background-color: var(--bs-primary-bg-subtle);
            border-radius: 0.475rem;
            width: 100%;
            height: 100%;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.04);
        }

        .card {
            border: 1px solid #e3e6f0;
            border-radius: 0.35rem;
        }

        .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
        }

        .badge.bg-dark {
            background-color: #2d3748 !important;
        }
    </style>

    <script>
        // Load services when modal opens
        document.getElementById('addServicePointModal').addEventListener('show.bs.modal', function () {
            fetchServicesForDropdown();
        });

        // Fetch services from backend
        async function fetchServicesForDropdown() {
            try {
                const response = await fetch('@Url.Action("GetServicesForDropdown", "Admin")');
                if (response.ok) {
                    const services = await response.json();
                    populateServiceDropdown(services);
                } else {
                    console.error('Failed to fetch services');
                    showError('Failed to load services. Please try again.');
                }
            } catch (error) {
                console.error('Error fetching services:', error);
                showError('Failed to load services. Please try again.');
            }
        }

        // Populate services dropdown
        function populateServiceDropdown(services) {
            const dropdown = document.getElementById('serviceId');
            dropdown.innerHTML = '<option value="" selected disabled>Select a service...</option>';

            services.forEach(service => {
                const option = document.createElement('option');
                option.value = service.id;
                option.textContent = `${service.name} (${service.prefix})`;
                dropdown.appendChild(option);
            });
        }

        // Show error message
        function showError(message) {
            const errorDiv = document.getElementById('servicePointFormError');
            errorDiv.textContent = message;
            errorDiv.classList.remove('d-none');
        }

        // Clear error when user starts typing in any field
        document.querySelectorAll('#addServicePointForm input, #addServicePointForm select').forEach(input => {
            input.addEventListener('input', () => {
                document.getElementById('servicePointFormError').classList.add('d-none');
            });
        });

        // Form submission handler
        document.getElementById('addServicePointForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            const submitBtn = document.getElementById('submitServicePointBtn');
            const originalText = submitBtn.innerHTML;
            const errorDiv = document.getElementById('servicePointFormError');
            const successDiv = document.getElementById('servicePointFormSuccess');

            // Hide previous messages
            errorDiv.classList.add('d-none');
            successDiv.classList.add('d-none');

            // Show loading
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
            submitBtn.disabled = true;

            // Prepare form data
            const formData = new FormData(this);

            try {
                const response = await fetch('@Url.Action("AddServicePoint", "Admin")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                if (response.ok) {
                    const result = await response.json();

                    // Success
                    successDiv.textContent = `Service point "${result.name}" added successfully!`;
                    successDiv.classList.remove('d-none');

                    // Clear form
                    this.reset();
                    document.getElementById('isActive').checked = true;

                    // Close modal after 2 seconds and reload page
                    setTimeout(() => {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('addServicePointModal'));
                        modal.hide();
                        window.location.reload();
                    }, 2000);
                } else {
                    // Error
                    const errorText = await response.text();
                    errorDiv.textContent = errorText || 'Error adding service point';
                    errorDiv.classList.remove('d-none');
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }
            } catch (error) {
                errorDiv.textContent = 'Network error. Please try again.';
                errorDiv.classList.remove('d-none');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });

        // Clear form and errors when modal is closed
        document.getElementById('addServicePointModal').addEventListener('hidden.bs.modal', function () {
            document.getElementById('addServicePointForm').reset();
            document.getElementById('servicePointFormError').classList.add('d-none');
            document.getElementById('servicePointFormSuccess').classList.add('d-none');
            document.getElementById('isActive').checked = true;

            // Reset submit button
            const submitBtn = document.getElementById('submitServicePointBtn');
            submitBtn.innerHTML = 'Add Service Point';
            submitBtn.disabled = false;
        });

        // Handle Edit button clicks
        document.querySelectorAll('.edit-service-point-btn').forEach(btn => {
            btn.addEventListener('click', async function () {
                const row = this.closest('tr');
                const servicePointId = row.cells[0].textContent; // Get ID from first column

                // Show loading state
                const editModal = new bootstrap.Modal(document.getElementById('editServicePointModal'));
                editModal.show();

                // Fetch service point data for editing
                await fetchServicePointForEdit(servicePointId);
            });
        });

        // Fetch service point data for editing
        async function fetchServicePointForEdit(id) {
            try {
                const response = await fetch(`@Url.Action("GetServicePointForEdit", "Admin")?id=${id}`);
                if (response.ok) {
                    const servicePoint = await response.json();
                    populateEditForm(servicePoint);
                } else {
                    console.error('Failed to fetch service point data');
                    showEditError('Failed to load service point data');
                }
            } catch (error) {
                console.error('Error fetching service point:', error);
                showEditError('Failed to load service point data');
            }
        }

        // Populate edit form with data
        function populateEditForm(servicePoint) {
            // Set hidden ID
            document.getElementById('editServicePointId').value = servicePoint.id;

            // Set name
            document.getElementById('editServicePointName').value = servicePoint.name;

            // Set active checkbox
            document.getElementById('editIsActive').checked = servicePoint.isActive;

            // Populate services dropdown and select current service
            fetchServicesForEditDropdown(servicePoint.serviceId);
        }

        // Fetch services for edit dropdown and select current one
        async function fetchServicesForEditDropdown(currentServiceId) {
            try {
                const response = await fetch('@Url.Action("GetServicesForDropdown", "Admin")');
                if (response.ok) {
                    const services = await response.json();
                    populateEditServiceDropdown(services, currentServiceId);
                }
            } catch (error) {
                console.error('Error fetching services for edit:', error);
            }
        }

        // Populate edit services dropdown and select current service
        function populateEditServiceDropdown(services, currentServiceId) {
            const dropdown = document.getElementById('editServiceId');
            dropdown.innerHTML = '<option value="" disabled>Select a service...</option>';

            services.forEach(service => {
                const option = document.createElement('option');
                option.value = service.id;
                option.textContent = `${service.name} (${service.prefix})`;
                if (service.id === currentServiceId) {
                    option.selected = true;
                }
                dropdown.appendChild(option);
            });
        }

        // Show error in edit modal
        function showEditError(message) {
            const errorDiv = document.getElementById('editServicePointFormError');
            errorDiv.textContent = message;
            errorDiv.classList.remove('d-none');
        }

        // Edit form submission handler
        document.getElementById('editServicePointForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            const submitBtn = document.getElementById('submitEditServicePointBtn');
            const originalText = submitBtn.innerHTML;
            const errorDiv = document.getElementById('editServicePointFormError');

            // Hide previous error
            errorDiv.classList.add('d-none');

            // Show loading
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
            submitBtn.disabled = true;

            // Prepare form data
            const formData = new FormData(this);
            formData.set('isActive', document.getElementById('editIsActive').checked);

            try {
                const response = await fetch('@Url.Action("EditServicePoint", "Admin")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('#editServicePointForm input[name="__RequestVerificationToken"]').value
                    }
                });

                if (response.ok) {
                    // Success - show toast and close modal
                    showSuccessAndClose('Service point updated successfully!');
                    // Reload page after 1.5 seconds
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    // Error
                    const errorText = await response.text();
                    errorDiv.textContent = errorText || 'Error updating service point';
                    errorDiv.classList.remove('d-none');
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }
            } catch (error) {
                errorDiv.textContent = 'Network error. Please try again.';
                errorDiv.classList.remove('d-none');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });

        // Show success toast and close modal
        function showSuccessAndClose(message) {
            // Create toast
            const toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white bg-success border-0 position-fixed bottom-0 end-0 m-3';
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            document.body.appendChild(toast);

            // Show toast
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();

            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('editServicePointModal'));
            if (modal) modal.hide();

            // Remove toast after 3 seconds
            setTimeout(() => toast.remove(), 3000);
        }
         document.querySelectorAll('.delete-service-point-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const servicePointId = btn.getAttribute('data-id');
            console.log('Delete service point ID:', servicePointId);
            new bootstrap.Modal(document.getElementById('deleteServicePointModal')).show();
        });
    });
    </script>