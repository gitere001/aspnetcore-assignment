@model List<Queue_Management_System.Models.Service>

@{
    ViewData["Title"] = "Services";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Service Management</h1>
            <p class="text-muted mb-0">Manage system services and their configurations</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addServiceModal">
            <i class="fas fa-plus-circle me-2"></i>Add Service
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Services
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-concierge-bell fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Active Services
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Unique Prefixes
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Select(s => s.PrefixCode).Distinct().Count()
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-hashtag fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Recently Added
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(s => s.CreatedAt >= DateTime.Now.AddDays(-7))
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Services Table -->
    <div class="card shadow">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">All Services</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="servicesTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Service Name</th>
                            <th>Prefix Code</th>
                            <th>Created Date</th>
                            <th>Age</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in Model)
                        {
                            <tr>
                                <td>@service.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="symbol symbol-40px me-3">
                                            <div class="symbol-label bg-light-primary">
                                                <span class="text-primary fw-bold">@service.Name.Substring(0, 1).ToUpper()</span>
                                            </div>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@service.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-dark">
                                        @service.PrefixCode.Replace("-", "")
                                    </span>
                                </td>
                                <td>@service.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @{
                                        var daysAgo = (DateTime.Now - service.CreatedAt).Days;
                                        var timeText = daysAgo == 0 ? "Today" : $"{daysAgo} day{(daysAgo == 1 ? "" : "s")} ago";
                                    }
                                    <span class="text-muted">@timeText</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-sm btn-outline-primary edit-service-btn" title="Edit" data-id="@service.Id">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger delete-service-btn" title="Delete" data-id="@service.Id">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="fas fa-concierge-bell fa-3x mb-3"></i>
                                        <p>No services found. Add your first service!</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-5">
                <i class="fas fa-plus text-primary mb-3" style="font-size: 3rem;"></i>
                <h4>Add Service Form</h4>
                <p class="text-muted">Add service functionality will be implemented here</p>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Service Modal -->
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-5">
                <i class="fas fa-edit text-primary mb-3" style="font-size: 3rem;"></i>
                <h4>Edit Service Form</h4>
                <p class="text-muted">Edit functionality will be implemented here</p>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Service Modal -->
<div class="modal fade" id="deleteServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-5">
                <i class="fas fa-exclamation-triangle text-danger mb-3" style="font-size: 3rem;"></i>
                <h4>Delete Service</h4>
                <p class="text-muted">Delete confirmation will be implemented here</p>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" disabled>Delete Service</button>
            </div>
        </div>
    </div>
</div>

<style>
    .symbol {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.475rem;
    }

    .symbol-40px {
        width: 40px;
        height: 40px;
    }

    .symbol-label {
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: var(--bs-primary);
        background-color: var(--bs-primary-bg-subtle);
        background-repeat: no-repeat;
        background-position: center center;
        background-size: cover;
        border-radius: 0.475rem;
        width: 100%;
        height: 100%;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.04);
    }

    .card {
        border: 1px solid #e3e6f0;
        border-radius: 0.35rem;
    }

    .card-header {
        background-color: #f8f9fc;
        border-bottom: 1px solid #e3e6f0;
    }

    .badge.bg-dark {
        background-color: #2d3748 !important;
    }
</style>

<script>

    // Edit button handlers
    document.querySelectorAll('.edit-service-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const serviceId = btn.getAttribute('data-id');
            console.log('Edit service ID:', serviceId);
            new bootstrap.Modal(document.getElementById('editServiceModal')).show();
        });
    });

    // Delete button handlers
    document.querySelectorAll('.delete-service-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const serviceId = btn.getAttribute('data-id');
            console.log('Delete service ID:', serviceId);
            new bootstrap.Modal(document.getElementById('deleteServiceModal')).show();
        });
    });

    // Auto-uppercase prefix code
    document.getElementById('prefixCode').addEventListener('input', function() {
        let cleanValue = this.value.replace(/-/g, '');
        this.value = cleanValue.toUpperCase();
    });
</script>