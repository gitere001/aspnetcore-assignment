@{
    ViewData["Title"] = "Analytical Reports";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-chart-line me-2"></i>Analytical Reports
        </h1>
    </div>

    <!-- Report Controls Card -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <!-- Main Report Controls - Single Line -->
                    <div class="row align-items-end g-3 mb-3">
                        <div class="col-auto">
                            <h6 class="mb-2 font-weight-bold text-primary">
                                <i class="fas fa-filter me-2"></i>Select Report Period
                            </h6>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold mb-1">Start Date</label>
                            <input type="date" class="form-control" id="startDate"
                                max="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold mb-1">End Date</label>
                            <input type="date" class="form-control" id="endDate"
                                max="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-auto">
                            <button type="button" class="btn btn-primary" id="applyBtn" onclick="loadReportData()">
                                <i class="fas fa-chart-bar me-2"></i>Generate Report
                            </button>
                        </div>
                    </div>

                    <!-- Quick Period Buttons - Second Line -->
                    <div class="d-flex flex-wrap gap-2">
                        <span class="text-muted small me-2 align-self-center">Quick Periods:</span>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setPeriod('today')">
                            Today
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setPeriod('yesterday')">
                            Yesterday
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setPeriod('week')">
                            Last 7 Days
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setPeriod('month')">
                            This Month
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setPeriod('lastmonth')">
                            Last Month
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Display Area -->
    <div class="row mt-4" id="reportContainer" style="display: none;">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-file-alt me-2"></i>Report Preview
                    </h6>
                    <div class="btn-group" id="actionButtons">
                        <button type="button" class="btn btn-success btn-sm" onclick="downloadPDF()">
                            <i class="fas fa-download me-1"></i>Download PDF
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="printReport()">
                            <i class="fas fa-print me-1"></i>Print
                        </button>
                    </div>
                </div>

                <!-- Loading Spinner -->
                <div id="loadingSpinner" class="text-center py-5" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading report data...</p>
                </div>

                <!-- Report Content -->
                <div class="card-body" id="reportContent">
                    <!-- Report will be inserted here by JavaScript -->
                </div>
            </div>
        </div>
    </div>

    <!-- Empty State -->
    <div class="row mt-4" id="emptyState">
        <div class="col-xl-6 col-lg-8 mx-auto">
            <div class="card shadow">
                <div class="card-body text-center py-5">
                    <i class="fas fa-chart-pie fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted mb-3">Your Report Will Appear Here</h5>
                    <p class="text-muted mb-0">Select dates and click "Generate Report" to view analytics</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Store report data globally
        let currentReportData = null;
        let currentStartDate = null;
        let currentEndDate = null;

        // Set default dates to last 7 days on page load
        $(document).ready(function () {
            setPeriod('week');
        });

        // Set period functions
        function setPeriod(period) {
            const today = new Date();
            let startDate, endDate;

            switch (period) {
                case 'today':
                    startDate = new Date(today);
                    endDate = new Date(today);
                    break;
                case 'yesterday':
                    startDate = new Date(today);
                    endDate = new Date(today);
                    startDate.setDate(startDate.getDate() - 1);
                    endDate.setDate(endDate.getDate() - 1);
                    break;
                case 'week':
                    startDate = new Date(today);
                    endDate = new Date(today);
                    startDate.setDate(startDate.getDate() - 7);
                    break;
                case 'month':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today);
                    break;
                case 'lastmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                    endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                    break;
            }

            $('#startDate').val(formatDate(startDate));
            $('#endDate').val(formatDate(endDate));
        }

        // Format date as YYYY-MM-DD
        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // Load report data via AJAX
        function loadReportData() {
            const startDate = $('#startDate').val();
            const endDate = $('#endDate').val();

            if (!startDate || !endDate) {
                alert('Please select both start and end dates');
                return;
            }

            if (new Date(startDate) > new Date(endDate)) {
                alert('Start date cannot be after end date');
                return;
            }

            // Store current dates
            currentStartDate = startDate;
            currentEndDate = endDate;

            // Show loading, hide empty state, show container
            $('#loadingSpinner').show();
            $('#emptyState').hide();
            $('#reportContainer').show();
            $('#reportContent').empty();
            $('#actionButtons').hide();

            // AJAX request
            $.ajax({
                url: '/Admin/GetAnalyticalReportData',
                type: 'GET',
                data: {
                    startDate: startDate,
                    endDate: endDate
                },
                success: function (response) {
                    currentReportData = response;
                    displayReport(response);
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    $('#reportContent').html(`
                                            <div class="alert alert-danger">
                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                Error loading report data: ${xhr.responseJSON?.error || 'Unknown error'}
                                            </div>
                                        `);
                }
            });
        }

        // Display report data
        function displayReport(data) {
            $('#loadingSpinner').hide();
            $('#actionButtons').show();

            if (!data.success || data.totalCustomersServed === 0) {
                $('#reportContent').html(`
                                        <div class="text-center py-4">
                                            <i class="fas fa-chart-line fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No Data Available</h5>
                                            <p class="text-muted">No customers were served in the selected period</p>
                                        </div>
                                    `);
                return;
            }

            let html = `
                                    <!-- Report Header -->
                                    <div class="mb-4 text-center">
                                        <h4 class="text-primary mb-2">Queue Management System</h4>
                                        <h5 class="text-dark mb-3">Analytical Report</h5>
                                        <p class="text-muted">
                                            ${formatDisplayDate(currentStartDate)} - ${formatDisplayDate(currentEndDate)}
                                        </p>
                                    </div>

                                    <!-- Summary -->
                                    <div class="card border-primary mb-4">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0"><i class="fas fa-list-alt me-2"></i>Overall Summary</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row text-center">
                                                <div class="col-md-4 mb-3 mb-md-0">
                                                    <div class="display-6 text-primary">${data.totalCustomersServed}</div>
                                                    <div class="text-muted">Customers Served</div>
                                                </div>
                                                <div class="col-md-4 mb-3 mb-md-0">
                                                    <div class="display-6 text-info">${data.overallAverageWaitTimeMinutes.toFixed(1)}</div>
                                                    <div class="text-muted">Avg Wait (minutes)</div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="display-6 text-success">${data.overallAverageServiceTimeMinutes.toFixed(1)}</div>
                                                    <div class="text-muted">Avg Service (minutes)</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                `;

            // Service Point Performance
            if (data.servicePointPerformance && data.servicePointPerformance.length > 0) {
                const activeServicePoints = data.servicePointPerformance;
                if (activeServicePoints.length > 0) {
                    html += `
                                            <div class="card border-secondary mb-4">
                                                <div class="card-header bg-light">
                                                    <h6 class="mb-0"><i class="fas fa-clinic-medical me-2"></i>Service Point Performance</h6>
                                                </div>
                                                <div class="card-body p-0">
                                                    <div class="table-responsive">
                                                        <table class="table table-hover mb-0">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Service Point</th>
                                                                    <th class="text-center">Served</th>
                                                                    <th class="text-center">Avg Wait</th>
                                                                    <th class="text-center">Avg Service</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                        `;

                    activeServicePoints.forEach(sp => {
                        html += `
                                                <tr>
                                                    <td><strong>${sp.servicePointName}</strong></td>
                                                    <td class="text-center">${sp.customersServed}</td>
                                                    <td class="text-center">${sp.averageWaitTimeMinutes.toFixed(1)} min</td>
                                                    <td class="text-center">${sp.averageServiceTimeMinutes.toFixed(1)} min</td>
                                                </tr>
                                            `;
                    });

                    html += `
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        `;
                }
            }

            // Staff Performance
            if (data.staffPerformance && data.staffPerformance.length > 0) {
                const activeStaff = data.staffPerformance;
                if (activeStaff.length > 0) {
                    html += `
                                            <div class="card border-secondary">
                                                <div class="card-header bg-light">
                                                    <h6 class="mb-0"><i class="fas fa-user-md me-2"></i>Staff Performance</h6>
                                                </div>
                                                <div class="card-body p-0">
                                                    <div class="table-responsive">
                                                        <table class="table table-hover mb-0">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Staff Member</th>
                                                                    <th>Service Point</th>
                                                                    <th class="text-center">Served</th>
                                                                    <th class="text-center">Avg Wait</th>
                                                                    <th class="text-center">Avg Service</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                        `;

                    activeStaff.forEach(staff => {
                        html += `
                                                <tr>
                                                    <td><strong>${staff.staffName}</strong></td>
                                                    <td>${staff.servicePointName}</td>
                                                    <td class="text-center">${staff.customersServed}</td>
                                                    <td class="text-center">${staff.averageWaitTimeMinutes.toFixed(1)} min</td>
                                                    <td class="text-center">${staff.averageServiceTimeMinutes.toFixed(1)} min</td>
                                                </tr>
                                            `;
                    });

                    html += `
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        `;
                }
            }

            $('#reportContent').html(html);
        }

        // Format date for display
        function formatDisplayDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            });
        }

        // Download PDF
        // Download PDF
        function downloadPDF() {
            if (!currentReportData || !currentStartDate || !currentEndDate) {
                alert('No report data available to download');
                return;
            }

            const downloadBtn = $('#actionButtons button:first');
            const originalHtml = downloadBtn.html();

            // Disable button and show processing
            downloadBtn.prop('disabled', true)
                .css('opacity', '0.7')
                .html('<i class="fas fa-spinner fa-spin me-1"></i>Processing...');

            const requestData = {
                startDate: currentStartDate,
                endDate: currentEndDate,
                reportData: currentReportData
            };

            $.ajax({
                url: '/Admin/GenerateReport',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                xhrFields: {
                    responseType: 'blob'
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (blob) {
                    // Create download link
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Queue_Analytics_${currentStartDate}_${currentEndDate}.pdf`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);

                    // Show success toast
                    alert('✓ Report downloaded successfully!');

                    // Re-enable button
                    downloadBtn.prop('disabled', false)
                        .css('opacity', '1')
                        .html(originalHtml);
                },
                error: function (xhr) {
                    alert('Error generating PDF: ' + (xhr.responseJSON?.error || 'Unknown error'));

                    // Re-enable button
                    downloadBtn.prop('disabled', false)
                        .css('opacity', '1')
                        .html(originalHtml);
                }
            });
        }

        // Print report
        function printReport() {
            if (!currentReportData) {
                alert('No report data available to print');
                return;
            }

            // Open print window
            const printWindow = window.open('', '_blank');
            printWindow.document.write(`
                                    <html>
                                    <head>
                                        <title>Queue Management System - Analytical Report</title>
                                        <style>
                                            body { font-family: Arial, sans-serif; margin: 20px; }
                                            .report-header { text-align: center; margin-bottom: 30px; }
                                            .report-header h1 { color: #2c3e50; margin-bottom: 5px; }
                                            .report-header h2 { color: #3498db; margin-bottom: 10px; }
                                            .summary { margin: 30px 0; padding: 20px; background: #f8f9fa; border-radius: 5px; }
                                            .summary h3 { margin-top: 0; }
                                            .table { width: 100%; border-collapse: collapse; margin: 20px 0; }
                                            .table th { background: #2c3e50; color: white; padding: 10px; text-align: left; }
                                            .table td { padding: 10px; border-bottom: 1px solid #ddd; }
                                            .section { margin: 40px 0; }
                                            .section h3 { border-bottom: 2px solid #3498db; padding-bottom: 5px; }
                                            @@media print {
                                                .no-print { display: none; }
                                                body { margin: 0; }
                                            }
                                        </style>
                                    </head>
                                    <body>
                                        <div class="report-header">
                                            <h1>QUEUE MANAGEMENT SYSTEM</h1>
                                            <h2>ANALYTICAL REPORT</h2>
                                            <p>${formatDisplayDate(currentStartDate)} - ${formatDisplayDate(currentEndDate)}</p>
                                        </div>

                                        <div class="summary">
                                            <h3>Overall Summary</h3>
                                            <p><strong>Total Customers Served:</strong> ${currentReportData.totalCustomersServed}</p>
                                            <p><strong>Average Wait Time:</strong> ${currentReportData.overallAverageWaitTimeMinutes.toFixed(1)} minutes</p>
                                            <p><strong>Average Service Time:</strong> ${currentReportData.overallAverageServiceTimeMinutes.toFixed(1)} minutes</p>
                                        </div>
                                `);

            // Add service point table
            const activeServicePoints = currentReportData.servicePointPerformance?.filter(sp => sp.customersServed > 0);
            if (activeServicePoints && activeServicePoints.length > 0) {
                printWindow.document.write(`
                                        <div class="section">
                                            <h3>Service Point Performance</h3>
                                            <table class="table">
                                                <tr>
                                                    <th>Service Point</th>
                                                    <th>Served</th>
                                                    <th>Avg Wait (min)</th>
                                                    <th>Avg Service (min)</th>
                                                </tr>
                                    `);

                activeServicePoints.forEach(sp => {
                    printWindow.document.write(`
                                            <tr>
                                                <td>${sp.servicePointName}</td>
                                                <td>${sp.customersServed}</td>
                                                <td>${sp.averageWaitTimeMinutes.toFixed(1)}</td>
                                                <td>${sp.averageServiceTimeMinutes.toFixed(1)}</td>
                                            </tr>
                                        `);
                });

                printWindow.document.write('</table></div>');
            }

            // Add staff table
            const activeStaff = currentReportData.staffPerformance?.filter(staff => staff.customersServed > 0);
            if (activeStaff && activeStaff.length > 0) {
                printWindow.document.write(`
                                        <div class="section">
                                            <h3>Staff Performance</h3>
                                            <table class="table">
                                                <tr>
                                                    <th>Staff Member</th>
                                                    <th>Service Point</th>
                                                    <th>Served</th>
                                                    <th>Avg Wait (min)</th>
                                                    <th>Avg Service (min)</th>
                                                </tr>
                                    `);

                activeStaff.forEach(staff => {
                    printWindow.document.write(`
                                            <tr>
                                                <td>${staff.staffName}</td>
                                                <td>${staff.servicePointName}</td>
                                                <td>${staff.customersServed}</td>
                                                <td>${staff.averageWaitTimeMinutes.toFixed(1)}</td>
                                                <td>${staff.averageServiceTimeMinutes.toFixed(1)}</td>
                                            </tr>
                                        `);
                });

                printWindow.document.write('</table></div>');
            }

            printWindow.document.write(`
                                        <div class="no-print" style="margin-top: 40px; text-align: center;">
                                            <button onclick="window.print()" style="padding: 10px 20px; background: #3498db; color: white; border: none; cursor: pointer;">
                                                Print Report
                                            </button>
                                        </div>
                                    </body>
                                    </html>
                                `);

            printWindow.document.close();
            printWindow.focus();
        }
    </script>

    <style>
        .card {
            border: none;
            border-radius: 8px;
        }

        .card-header {
            border-bottom: 1px solid #e3e6f0;
            border-radius: 8px 8px 0 0 !important;
        }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .btn-outline-primary {
            border-width: 2px;
            font-weight: 500;
        }

        .btn-outline-primary:hover {
            transform: translateY(-1px);
            transition: all 0.2s ease;
        }

        #applyBtn {
            padding: 10px 24px;
            font-weight: 600;
            font-size: 1.1rem;
        }

        #actionButtons .btn {
            border-radius: 6px;
            font-weight: 500;
        }

        .display-6 {
            font-weight: 700;
        }

        .form-control:focus {
            border-color: #4e73df;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
        }
    </style>
}