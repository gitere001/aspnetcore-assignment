@{
    ViewData["Title"] = "Now Serving";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Now Serving - Queue Management System</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Local CSS -->
    <link rel="stylesheet" href="~/css/waiting.css">
</head>

<body>
    <!-- Voice Enable Modal -->
    <div class="voice-modal-overlay" id="voiceModal">
        <div class="voice-modal">
            <div class="voice-modal-icon">
                <i class="fas fa-volume-up"></i>
            </div>
            <h2 class="voice-modal-title">Enable Voice Announcements</h2>
            <p class="voice-modal-text">
                This display uses voice to call ticket numbers.<br>
                Please enable sound to hear announcements.
            </p>
            <button class="voice-enable-btn" id="enableVoiceBtn" onclick="enableVoice()">
                <i class="fas fa-check-circle"></i> Enable Voice
            </button>
        </div>
    </div>

    <div class="container">
        <div class="display-card">

            <!-- Header -->
            <div class="header">
                <h1 class="main-title">
                    <i class="fas fa-bullhorn"></i> Now Serving
                </h1>
                <p class="subtitle">Please proceed to your assigned service point when your number is called</p>
            </div>

            <!-- Tickets Display -->
            <div class="tickets-container" id="ticketsContainer">
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="empty-text">No tickets are currently being served</div>
                </div>
            </div>

        </div>
    </div>

    <script>
        // ── Voice Permission Manager ───────────────────────
        const voiceManager = {
            enabled: false,
            modal: null,
            button: null,

            init() {
                this.modal = document.getElementById('voiceModal');
                this.button = document.getElementById('enableVoiceBtn');
                // Modal is visible by default - user MUST click to enable
            },

            setEnabled() {
                this.enabled = true;

                // Hide modal with fade out
                if (this.modal) {
                    this.modal.style.animation = 'fadeOut 0.3s ease';
                    setTimeout(() => {
                        this.modal.style.display = 'none';
                    }, 300);
                }
            },

            isEnabled() {
                return this.enabled;
            }
        };

        // ── Voice Enable Function ──────────────────────────
        function enableVoice() {
            const btn = document.getElementById('enableVoiceBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enabling...';

            // Test utterance to unlock voice (CRITICAL!)
            const testUtterance = new SpeechSynthesisUtterance("Voice enabled.");
            testUtterance.volume = 0.3;
            testUtterance.rate = 0.9;

            testUtterance.onstart = () => {
                console.log('✅ Voice unlocked successfully');
            };

            testUtterance.onend = () => {
                // Mark as enabled
                voiceManager.setEnabled();
            };

            testUtterance.onerror = (e) => {
                console.error('Voice error:', e.error);
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Try Again';
            };

            // This unlocks voice for the entire page session
            window.speechSynthesis.speak(testUtterance);
        }

        // ── State ──────────────────────────────────────────
        const state = {
            initialized: false,  // first fetch done? (don't speak on page load)
            isSpeaking: false    // speaking lock to prevent race conditions
        };

        // ── Voice Setup ────────────────────────────────────
        let voices = [];

        function loadVoices() {
            voices = window.speechSynthesis.getVoices();
        }

        // Chrome loads voices asynchronously
        if (window.speechSynthesis.onvoiceschanged !== undefined) {
            window.speechSynthesis.onvoiceschanged = loadVoices;
        }
        loadVoices();

        // Pick the best natural English voice available on the device
        function getBestVoice() {
            const preferred = [
                v => v.name.includes('Google') && v.lang.startsWith('en'),
                v => v.name.includes('Samantha') && v.lang.startsWith('en'),
                v => v.name.includes('Alex') && v.lang.startsWith('en'),
                v => v.name.includes('Daniel') && v.lang.startsWith('en'),
                v => v.lang === 'en-US',
                v => v.lang.startsWith('en')
            ];
            for (const match of preferred) {
                const found = voices.find(match);
                if (found) return found;
            }
            return voices[0] || null;
        }

        // Speak one message, call onDone when finished
        function speak(text, onDone) {
            // CRITICAL: Check if voice is enabled before speaking
            if (!voiceManager.isEnabled()) {
                console.log('⚠️ Voice not enabled yet, skipping announcement');
                if (onDone) onDone();
                return;
            }

            if (!window.speechSynthesis) {
                if (onDone) onDone();
                return;
            }

            // Chrome bug: must cancel before speaking new utterance
            window.speechSynthesis.cancel();

            // Small delay so cancel clears properly before next speak
            setTimeout(() => {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.voice = getBestVoice();
                utterance.rate = 0.95;
                utterance.pitch = 1.0;
                utterance.volume = 1.0;
                utterance.lang = 'en-US';

                utterance.onend = () => { if (onDone) onDone(); };
                utterance.onerror = () => { if (onDone) onDone(); };

                window.speechSynthesis.speak(utterance);
            }, 150);
        }

        // ── Mark As Announced ──────────────────────────────
        async function markAsAnnounced(ticketNumber) {
            try {
                await fetch('/Queue/MarkAsAnnounced', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketNumber: ticketNumber })
                });
                console.log(`✅ Marked ${ticketNumber} as announced`);
            } catch (error) {
                console.error('Error marking ticket as announced:', error);
            }
        }

        // ── Fetch & Sync ───────────────────────────────────
        async function fetchTickets() {
            try {
                const response = await fetch('/Queue/GetCalledTickets');
                const data = await response.json();
                const incoming = data.tickets || [];

                await syncTickets(incoming);
                renderTickets(incoming);
            } catch (error) {
                console.error('Error fetching tickets:', error);
            }
        }

        // Compare incoming vs current state — announce only hasAnnouncement = true
        async function syncTickets(incoming) {
            // First load: just mark as initialized, don't announce
            if (!state.initialized) {
                state.initialized = true;
                console.log('📋 First load - skipping announcements');
                return;
            }

            // Check if already speaking - prevent race condition
            if (state.isSpeaking) {
                console.log('⏸️ Already speaking, skipping this poll');
                return;
            }

            // Find tickets that need announcement
            const needsAnnouncement = incoming.filter(t => t.hasAnnouncement === true);

            if (needsAnnouncement.length === 0) {
                return;
            }

            console.log(`📢 Found ${needsAnnouncement.length} ticket(s) to announce`);

            // Only announce if voice is enabled
            if (!voiceManager.isEnabled()) {
                console.log('⚠️ Voice not enabled, skipping announcements');
                return;
            }

            // Lock speaking to prevent duplicate announcements
            state.isSpeaking = true;

            // Announce each ticket sequentially
            for (const ticket of needsAnnouncement) {
                await announceTicket(ticket);
                // Mark as announced immediately after speaking
                await markAsAnnounced(ticket.ticketNumber);
            }

            // Unlock after all announcements complete
            state.isSpeaking = false;
            console.log('🔓 Speaking lock released');
        }

        // Announce a single ticket
        function announceTicket(ticket) {
            return new Promise((resolve) => {
                // Format ticket number for clear pronunciation
                const parts = ticket.ticketNumber.split('-');
                const prefix = parts[0].split('').join(' ');
                const number = parts[1].split('').join(' ');
                const text = `Ticket number ${prefix} dash ${number}, please proceed to Service number ${ticket.servicePointId}.`;

                console.log(`🔊 Announcing: ${ticket.ticketNumber}`);

                speak(text, () => {
                    console.log(`✅ Finished announcing: ${ticket.ticketNumber}`);
                    // Wait 2 seconds before next announcement
                    setTimeout(resolve, 2000);
                });
            });
        }

        // ── Render ─────────────────────────────────────────
        function renderTickets(tickets) {
            const container = document.getElementById('ticketsContainer');

            if (tickets.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon"><i class="fas fa-clock"></i></div>
                        <div class="empty-text">No tickets are currently being served</div>
                    </div>`;
                return;
            }

            let html = '';
            tickets.forEach(ticket => {
                html += `
                    <div class="ticket-card fade-in">
                        <div class="ticket-number">${ticket.ticketNumber}</div>
                        <div class="service-point">Please proceed to</div>
                        <div>
                            <span class="counter-badge">
                                <i class="fas fa-map-marker-alt"></i> Service ${ticket.servicePointId}
                            </span>
                        </div>
                        <div class="status-indicator">
                            <span class="status-dot"></span>
                            <span class="status-text">Currently Called</span>
                        </div>
                    </div>`;
            });

            container.innerHTML = html;
        }

        // ── Init ───────────────────────────────────────────
        // Initialize voice manager FIRST
        voiceManager.init();

        // Then start fetching tickets
        fetchTickets();
        setInterval(fetchTickets, 3000);

        // Page refresh every 30 min to stay clean
        setTimeout(() => window.location.reload(), 30 * 60 * 1000);
    </script>
</body>

</html>