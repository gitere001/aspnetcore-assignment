<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staff Dashboard</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            * {
                font-family: 'Inter', sans-serif;
            }

            body {
                background-color: #f9fafb;
                margin: 0;
                padding: 0;
            }

            /* Top Bar Styles */
            .topbar {
                height: 4rem;
                background: white;
                border-bottom: 1px solid #e5e7eb;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 30;
                padding: 0 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            .staff-info {
                display: flex;
                flex-direction: column;
            }

            .staff-name {
                font-weight: 600;
                font-size: 1rem;
                color: #111827;
            }

            .staff-status {
                font-size: 0.75rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .assignment-badge {
                display: inline-flex;
                align-items: center;
                padding: 0.125rem 0.5rem;
                border-radius: 9999px;
                font-size: 0.75rem;
                font-weight: 500;
            }

            .assignment-badge.assigned {
                background-color: #dcfce7;
                color: #166534;
            }

            .assignment-badge.not-assigned {
                background-color: #fef3c7;
                color: #92400e;
            }

            .assignment-badge.inactive {
                background-color: #fee2e2;
                color: #991b1b;
            }

            .assignment-badge i {
                font-size: 0.625rem;
                margin-right: 0.25rem;
            }

            .profile-btn {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.5rem 0.75rem;
                border-radius: 0.5rem;
                border: none;
                background: transparent;
                color: #6b7280;
                cursor: pointer;
                transition: all 0.2s;
            }

            .profile-btn:hover {
                background-color: #f3f4f6;
            }

            .profile-avatar {
                width: 2rem;
                height: 2rem;
                border-radius: 50%;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: 600;
                font-size: 0.875rem;
            }

            /* Dropdown Styles */
            .dropdown-menu {
                min-width: 280px;
                border-radius: 0.5rem;
                padding: 0.5rem;
                margin-top: 0.5rem;
            }

            .dropdown-header-custom {
                padding: 0.75rem 1rem;
                border-bottom: 1px solid #e5e7eb;
                margin-bottom: 0.5rem;
            }

            .dropdown-user-name {
                font-weight: 600;
                font-size: 0.9375rem;
                color: #111827;
                margin-bottom: 0.25rem;
            }

            .dropdown-user-role {
                font-size: 0.8125rem;
                color: #6b7280;
            }

            .dropdown-section {
                padding: 0.5rem 1rem;
                border-bottom: 1px solid #e5e7eb;
                margin-bottom: 0.5rem;
            }

            .dropdown-section-title {
                font-size: 0.75rem;
                color: #6b7280;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                margin-bottom: 0.5rem;
            }

            .service-point-info {
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .service-point-icon {
                width: 2rem;
                height: 2rem;
                border-radius: 0.375rem;
                background-color: #f3f4f6;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #6b7280;
            }

            .service-point-details {
                flex: 1;
            }

            .service-point-name {
                font-weight: 500;
                font-size: 0.875rem;
                color: #111827;
            }

            .service-point-status {
                font-size: 0.75rem;
                color: #6b7280;
            }

            .dropdown-item-custom {
                display: flex;
                align-items: center;
                padding: 0.5rem 1rem;
                border-radius: 0.375rem;
                color: #374151;
                text-decoration: none;
                transition: all 0.2s;
                border: none;
                background: transparent;
                width: 100%;
                text-align: left;
                cursor: pointer;
            }

            .dropdown-item-custom:hover {
                background-color: #f3f4f6;
                color: #111827;
            }

            .dropdown-item-custom i {
                margin-right: 0.75rem;
                width: 1rem;
                text-align: center;
            }

            .dropdown-divider {
                margin: 0.5rem 0;
                border-top: 1px solid #e5e7eb;
            }

            /* Main Content Styles */
            .main-content {
                margin-top: 4rem;
                height: calc(100vh - 4rem);
                overflow-y: auto;
                padding: 1.5rem;
            }

            /* Responsive adjustments */
            @@media (max-width: 640px) {
                .topbar {
                    padding: 0 1rem;
                }

                .staff-status {
                    font-size: 0.7rem;
                }

                .assignment-badge {
                    font-size: 0.7rem;
                    padding: 0.1rem 0.4rem;
                }

                .dropdown-menu {
                    min-width: 260px;
                }
            }
    </style>
</head>
<body>
    <!-- Top Bar -->
    <div class="topbar">
        <div class="topbar-left">
            <div class="staff-info">
                <div class="staff-name">@(ViewBag.StaffName ?? "Staff Member")</div>
                <div class="staff-status">
                    @if (ViewBag.ServicePointId != null)
                    {
                        @if (ViewBag.ServicePointIsActive == true)
                        {
                            <span class="assignment-badge assigned">
                                <i class="fas fa-check-circle"></i>
                                Assigned to @ViewBag.ServicePointName
                            </span>
                        }
                        else
                        {
                            <span class="assignment-badge inactive">
                                <i class="fas fa-exclamation-circle"></i>
                                Service Point Inactive
                            </span>
                        }
                    }
                    else
                    {
                        <span class="assignment-badge not-assigned">
                            <i class="fas fa-info-circle"></i>
                            Not Assigned to Service Point
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">


            <!-- Profile Dropdown -->
            <div class="dropdown">
                <button class="profile-btn" type="button" id="profileDropdown" data-bs-toggle="dropdown"
                        aria-expanded="false">
                    <div class="profile-avatar">
                        @{
                            string initials = "S";
                            if (ViewBag.StaffName != null)
                            {
                                string staffName = ViewBag.StaffName.ToString();
                                var nameParts = staffName.Split(' ');
                                initials = "";
                                foreach (var part in nameParts)
                                {
                                    if (!string.IsNullOrEmpty(part))
                                    {
                                        initials += part[0];
                                    }
                                }
                                initials = initials.ToUpper();
                                if (initials.Length > 2)
                                {
                                    initials = initials.Substring(0, 2);
                                }
                            }
                        }
                        @initials
                    </div>

                </button>

                <div class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="profileDropdown">
                    <!-- User Info Header -->
                    <div class="dropdown-header-custom">
                        <div class="dropdown-user-name">@(ViewBag.StaffName ?? "Staff Member")</div>
                        <div class="dropdown-user-role">Staff Member</div>
                    </div>

                    <!-- Service Point Assignment -->
                    <div class="dropdown-section">
                        <div class="dropdown-section-title">Assignment</div>
                        @if (ViewBag.ServicePointId != null)
                        {
                            <div class="service-point-info">
                                <div class="service-point-icon">
                                    <i class="fas fa-map-marker-alt"></i>
                                </div>
                                <div class="service-point-details">
                                    <div class="service-point-name">@ViewBag.ServicePointName</div>
                                    <div class="service-point-status">
                                        @if (ViewBag.ServicePointIsActive == true)
                                        {
                                            <i class="fas fa-circle text-success" style="font-size: 0.5rem;"></i>
                                            <span>Active</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-circle text-danger" style="font-size: 0.5rem;"></i>
                                            <span>Inactive</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">
                                <i class="fas fa-info-circle me-1"></i>
                                No service point assigned
                            </div>
                        }
                    </div>



                    <div class="dropdown-divider"></div>

                    <!-- Logout -->
                    <form method="post" action="@Url.Action("Logout", "Auth")" style="display: inline; width: 100%;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item-custom text-danger">
                            <i class="fas fa-sign-out-alt"></i>
                            Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>