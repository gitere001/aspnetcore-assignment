@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Queue Management System</title>

	<!-- Bootstrap 5 CSS -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<!-- Font Awesome -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<!-- Google Fonts (Inter) -->
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

	<style>
			:root {
				--sidebar-width: 16rem;
				/* 64px when collapsed */
				--sidebar-collapsed-width: 4rem;
				--primary-color: #0d6efd;
				/* Bootstrap blue */
			}

			* {
				font-family: 'Inter', sans-serif;
			}

			body {
				background-color: #f9fafb;
				overflow: hidden;
			}

			/* Sidebar Styles */
			.sidebar {
				width: var(--sidebar-width);
				height: 100vh;
				background: white;
				border-right: 1px solid #e5e7eb;
				transition: all 0.3s ease;
				position: fixed;
				left: 0;
				top: 0;
				z-index: 40;
			}

			.sidebar.collapsed {
				width: var(--sidebar-collapsed-width);
			}

			.sidebar-header {
				padding: 1rem;
				border-bottom: 1px solid #e5e7eb;
			}

			.logo {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 2.5rem;
				height: 2.5rem;
				background-color: var(--primary-color);
				/* Changed to blue */
				border-radius: 0.375rem;
				color: white;
				font-weight: bold;
				font-size: 1.125rem;
			}

			.sidebar-nav {
				padding: 1rem 0.5rem;
			}

			.nav-item {
				display: flex;
				align-items: center;
				padding: 0.5rem 0.75rem;
				margin-bottom: 0.25rem;
				border-radius: 0.375rem;
				color: #4b5563;
				text-decoration: none;
				transition: all 0.2s ease;
			}

			.nav-item:hover {
				background-color: #f3f4f6;
				color: #111827;
			}

			.nav-item.active {
				background-color: rgba(13, 110, 253, 0.1);
				/* Blue with opacity */
				color: var(--primary-color);
				/* Blue */
			}

			.nav-item i {
				width: 1.25rem;
				height: 1.25rem;
				flex-shrink: 0;
			}

			.nav-item span {
				margin-left: 0.5rem;
				white-space: nowrap;
				overflow: hidden;
				transition: opacity 0.3s ease;
			}

			.sidebar.collapsed .nav-item span {
				opacity: 0;
				width: 0;
			}

			.collapse-btn {
				position: absolute;
				bottom: 1rem;
				left: 50%;
				transform: translateX(-50%);
				padding: 0.5rem;
				border-radius: 0.375rem;
				color: #9ca3af;
				background: transparent;
				border: none;
				cursor: pointer;
			}

			.collapse-btn:hover {
				background-color: #f3f4f6;
				color: #6b7280;
			}

			/* Top Bar Styles */
			.topbar {
				height: 4rem;
				background: white;
				border-bottom: 1px solid #e5e7eb;
				position: fixed;
				top: 0;
				right: 0;
				left: var(--sidebar-width);
				z-index: 30;
				transition: left 0.3s ease;
				padding: 0 1.5rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				/* FIXED: Makes profile go to right */
			}

			.sidebar.collapsed~.topbar {
				left: var(--sidebar-collapsed-width);
			}

			.mobile-menu-btn {
				display: none;
				padding: 0.5rem;
				border-radius: 0.375rem;
				color: #9ca3af;
				background: transparent;
				border: none;
			}

			.mobile-menu-btn:hover {
				background-color: #f3f4f6;
				color: #6b7280;
			}

			.profile-btn {
				display: flex;
				align-items: center;
				padding: 0.5rem;
				border-radius: 0.5rem;
				border: none;
				background: transparent;
				color: #6b7280;
				cursor: pointer;
			}

			.profile-btn:hover {
				background-color: #f3f4f6;
			}

			/* Main Content Styles */
			.main-content {
				margin-top: 4rem;
				margin-left: var(--sidebar-width);
				height: calc(100vh - 4rem);
				overflow-y: auto;
				padding: 1.5rem;
				transition: margin-left 0.3s ease;
			}

			.sidebar.collapsed~.main-content {
				margin-left: var(--sidebar-collapsed-width);
			}

			/* Mobile Overlay */
			.mobile-overlay {
				position: fixed;
				inset: 0;
				background-color: rgba(0, 0, 0, 0.5);
				z-index: 45;
				display: none;
			}

			.mobile-overlay.active {
				display: block;
			}

			/* Mobile Sidebar */
			.mobile-sidebar {
				position: fixed;
				inset: 0;
				right: auto;
				width: 16rem;
				background: white;
				transform: translateX(-100%);
				transition: transform 0.3s ease;
				z-index: 50;
				display: none;
			}

			.mobile-sidebar.active {
				transform: translateX(0);
				display: block;
			}

			/* Responsive */
			@@media (max-width: 1024px) {
				.sidebar {
					display: none;
				}

				.topbar {
					left: 0 !important;
				}

				.main-content {
					margin-left: 0 !important;
				}

				.mobile-menu-btn {
					display: block;
				}

				/* Fix mobile sidebar content visibility */
				.mobile-sidebar .sidebar {
					display: block !important;
					width: 100% !important;
				}

				.mobile-sidebar .sidebar-nav {
					display: block !important;
				}

				.mobile-sidebar .nav-item span {
					opacity: 1 !important;
					width: auto !important;
				}
			}
	</style>
</head>

<body>
	<!-- Desktop Sidebar -->
	<div class="sidebar" id="desktopSidebar">
		<div class="sidebar-header">
			<div class="d-flex align-items-center">
				<div class="logo">QS</div>
				<div class="ms-3 d-none d-lg-block">
					<span class="fw-bold">Queue System</span>
					<div class="text-muted small">Admin Dashboard</div>
				</div>
			</div>
		</div>

		<div class="sidebar-nav">
			<a href="@Url.Action("Dashboard", "Admin")"
				   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
				<i class="fas fa-home"></i>
				<span>Dashboard</span>
			</a>
			<a href="@Url.Action("Reports", "Admin")"
				   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")">
				<i class="fas fa-chart-bar"></i>
				<span>Reports</span>
			</a>
			<a href="@Url.Action("Users", "Admin")"
				   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
				<i class="fas fa-users"></i>
				<span>Users</span>
			</a>
			<a href="@Url.Action("ServicePoints", "Admin")"
				   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "ServicePoints" ? "active" : "")">
				<i class="fas fa-map-marker-alt"></i>
				<span>Service Points</span>
			</a>
			<a href="@Url.Action("Services", "Admin")"
				   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Services" ? "active" : "")">
				<i class="fas fa-concierge-bell"></i>
				<span>Services</span>
			</a>
		</div>

		<button class="collapse-btn" id="collapseBtn">
			<i class="fas fa-bars"></i>
		</button>
	</div>

	<!-- Mobile Overlay -->
	<div class="mobile-overlay" id="mobileOverlay"></div>

	<!-- Mobile Sidebar -->
	<div class="mobile-sidebar" id="mobileSidebar">
		<div class="sidebar">
			<div class="sidebar-header">
				<div class="d-flex align-items-center justify-content-between">
					<div class="d-flex align-items-center">
						<div class="logo">QS</div>
						<div class="ms-3">
							<span class="fw-bold">Queue System</span>
							<div class="text-muted small">Admin Dashboard</div>
						</div>
					</div>
					<button class="btn p-1" id="closeMobileSidebar">
						<i class="fas fa-times text-muted"></i>
					</button>
				</div>
			</div>

			<div class="sidebar-nav">
				<a href="@Url.Action("Dashboard", "Admin")"
					   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
					   onclick="closeMobileSidebar()">
					<i class="fas fa-home"></i>
					<span>Dashboard</span>
				</a>
				<a href="@Url.Action("Reports", "Admin")"
					   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")"
					   onclick="closeMobileSidebar()">
					<i class="fas fa-chart-bar"></i>
					<span>Reports</span>
				</a>
				<a href="@Url.Action("Users", "Admin")"
					   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")"
					   onclick="closeMobileSidebar()">
					<i class="fas fa-users"></i>
					<span>Users</span>
				</a>
				<a href="@Url.Action("ServicePoints", "Admin")"
					   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "ServicePoints" ? "active" : "")"
					   onclick="closeMobileSidebar()">
					<i class="fas fa-map-marker-alt"></i>
					<span>Service Points</span>
				</a>
				<a href="@Url.Action("Services", "Admin")"
					   class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Services" ? "active" : "")"
					   onclick="closeMobileSidebar()">
					<i class="fas fa-concierge-bell"></i>
					<span>Services</span>
				</a>
			</div>

			<button class="collapse-btn" id="collapseBtnMobile" onclick="closeMobileSidebar()">
				<i class="fas fa-bars"></i>
			</button>
		</div>
	</div>

	<!-- Top Bar -->
	<div class="topbar">
		<button class="mobile-menu-btn" id="mobileMenuBtn">
			<i class="fas fa-bars"></i>
		</button>

		<!-- Empty div to push profile to right -->
		<div style="flex: 1;"></div>

		<div class="d-flex align-items-center gap-3">
			<div class="dropdown">
				<button class="profile-btn" type="button" id="profileDropdown" data-bs-toggle="dropdown">
					<i class="fas fa-user-circle fs-4"></i>
					<i class="fas fa-chevron-down ms-1 small"></i>
				</button>
				<div class="dropdown-menu dropdown-menu-end shadow-sm border">
					<div class="px-4 py-2 border-bottom">
						<div class="fw-medium">Admin User</div>
						<div class="text-muted small">Administrator</div>
					</div>
					<a class="dropdown-item" href="@Url.Action("Settings", "Admin")">
						<i class="fas fa-cog me-2"></i>Settings
					</a>
					<form method="post" action="@Url.Action("Logout", "Auth")" style="display: inline;">
						<button type="submit" class="dropdown-item border-0 bg-transparent w-100 text-start">
							<i class="fas fa-sign-out-alt me-2"></i>Sign out
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>

	<!-- Main Content -->
	<div class="main-content">
		@RenderBody()
	</div>

	<!-- Bootstrap JS -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

	<script>
		// Toggle sidebar collapse
		document.getElementById('collapseBtn').addEventListener('click', function () {
		document.getElementById('desktopSidebar').classList.toggle('collapsed');
		});

		// Mobile menu toggle
		document.getElementById('mobileMenuBtn').addEventListener('click', function () {
		document.getElementById('mobileSidebar').classList.add('active');
		document.getElementById('mobileOverlay').classList.add('active');
		});

		// Close mobile sidebar
		document.getElementById('closeMobileSidebar').addEventListener('click', closeMobileSidebar);
		document.getElementById('mobileOverlay').addEventListener('click', closeMobileSidebar);

		function closeMobileSidebar() {
		document.getElementById('mobileSidebar').classList.remove('active');
		document.getElementById('mobileOverlay').classList.remove('active');
		}

		// Close mobile sidebar when clicking nav links
		document.querySelectorAll('#mobileSidebar .nav-item').forEach(item => {
		item.addEventListener('click', closeMobileSidebar);
		});
	</script>

	@RenderSection("Scripts", required: false)
</body>

</html>