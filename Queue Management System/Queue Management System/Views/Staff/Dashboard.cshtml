async function leaveServicePoint() {
    const btn = document.getElementById('leaveSpBtn');
    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Leaving...';

    try {
        const response = await fetch('/Staff/LeaveServicePoint', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        });

        const data = await response.json();

        if (data.success) {
            showNotification(data.message, 'success');
            // Reload page after 1 second
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        } else {
            showNotification(data.error || 'Failed to leave station', 'error');
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
            } catch (error) {
                console.error('Error leaving station:', error);
                showNotification('Failed to leave station', 'error');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

                // Cleanup on page unload
                window.addEventListener('beforeunload', function () {
                    stopPolling();
                    if (ticketTimerInterval) {
                        clearInterval(ticketTimerInterval);
                    }
                });

                // Show transfer modal
async function showTransferModal() {
    if (!currentTicket || currentStatus !== 'Serving') return;

    const errorDiv = document.getElementById('transferError');
    const successDiv = document.getElementById('transferSuccess');
    const select = document.getElementById('transferServicePointSelect');
    const confirmBtn = document.getElementById('confirmTransferBtn');
    const infoDiv = document.getElementById('transferInfo');

    // Clear previous
    errorDiv.classList.add('d-none');
    successDiv.classList.add('d-none');
    infoDiv.classList.add('d-none');
    select.innerHTML = '<option value="" selected disabled>-- Loading available service points... --</option>';
    confirmBtn.disabled = true;

    // Set current ticket
    document.getElementById('transferTicketNumber').textContent = currentTicket;

    try {
        // Load available service points
        const response = await fetch('/Staff/GetServicePointsForAssignment');
        const data = await response.json();
        console.log('Available service points for transfer:', data);

        if (data.error) {
            errorDiv.textContent = data.error;
            errorDiv.classList.remove('d-none');
            return;
        }

        // Populate dropdown (exclude current service point)
        select.innerHTML = '<option value="" selected disabled>-- Select Destination --</option>';

        let hasOptions = false;
        data.forEach(point => {
            // Show active service points that are NOT the current one
            if (point.isActive && point.id !== @(Model.ServicePointId ?? 0)) {
                const option = document.createElement('option');
                option.value = point.id;
                option.textContent = `${point.name} (${point.isAssigned ? 'Occupied' : 'Available'})`;
                option.setAttribute('data-name', point.name);
                select.appendChild(option);
                hasOptions = true;
            }
        });

        if (!hasOptions) {
            select.innerHTML = '<option value="" selected disabled>-- No available service points --</option>';
        }

        // Show modal
        new bootstrap.Modal(document.getElementById('transferTicketModal')).show();

    } catch (error) {
        console.error('Error loading service points:', error);
        errorDiv.textContent = 'Failed to load service points. Please try again.';
        errorDiv.classList.remove('d-none');
    }
}

// When destination is selected
document.getElementById('transferServicePointSelect').addEventListener('change', function(event) {
    const select = event.target;
    const confirmBtn = document.getElementById('confirmTransferBtn');
    const infoDiv = document.getElementById('transferInfo');

    if (select.value === "") {
        confirmBtn.disabled = true;
        infoDiv.classList.add('d-none');
        return;
    }

    const selectedOption = select.options[select.selectedIndex];
    document.getElementById('transferDestination').textContent = selectedOption.getAttribute('data-name');
    document.getElementById('transferService').textContent = selectedOption.getAttribute('data-service') || 'General';

    infoDiv.classList.remove('d-none');
    confirmBtn.disabled = false;
});

// Confirm transfer
document.getElementById('confirmTransferBtn').addEventListener('click', async function() {
    const select = document.getElementById('transferServicePointSelect');
    const errorDiv = document.getElementById('transferError');
    const successDiv = document.getElementById('transferSuccess');
    const confirmBtn = document.getElementById('confirmTransferBtn');

    if (select.value === "" || !currentTicket) {
        errorDiv.textContent = 'Please select a destination';
        errorDiv.classList.remove('d-none');
        return;
    }

    const servicePointId = parseInt(select.value);

    // Show loading
    confirmBtn.disabled = true;
    const originalText = confirmBtn.innerHTML;
    confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Transferring...';

    try {
        // Call your existing TransferTicket API
        const response = await fetch('/Staff/TransferTicket', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                servicePointId: servicePointId
            })
        });

        const data = await response.json();

       if (data.success) {
    // Success
    successDiv.textContent = data.message;
    successDiv.classList.remove('d-none');

    // Close modal and reload
    setTimeout(() => {
        const modal = bootstrap.Modal.getInstance(document.getElementById('transferTicketModal'));
        modal.hide();
        showNotification(data.message, 'success');
        window.location.reload();  // This is the only line you need to add
    }, 1500);
} else {
            // Error
            errorDiv.textContent = data.error || 'Failed to transfer ticket';
            errorDiv.classList.remove('d-none');
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = originalText;
        }

    } catch (error) {
        console.error('Error transferring ticket:', error);
        errorDiv.textContent = 'Failed to transfer ticket. Please try again.';
        errorDiv.classList.remove('d-none');
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = originalText;
    }
});
