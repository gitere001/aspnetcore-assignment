@model Queue_Management_System.Models.User

@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "_LayoutStaff";
}

<div class="container-fluid">
    <!-- Status Alert -->
    @if (!Model.ServicePointId.HasValue)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>No Service Point Assigned!</strong> Please contact your administrator to be assigned to a service
            counter.
        </div>
    }
    else if (!Model.ServicePointIsActive)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-pause-circle me-2"></i>
            <strong>Service Point Offline!</strong> Your counter is currently offline. Click "Go Online" to start serving
            customers.
        </div>
    }
    else
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Ready to Serve!</strong> Your service point <strong>@Model.ServicePointName</strong> is online and
            ready.
        </div>
    }

    <!-- Main Dashboard Cards -->
    <div class="row">
        <!-- Left Column: Current Ticket -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-ticket-alt me-2"></i>Current Ticket
                    </h5>
                </div>
                <div class="card-body text-center p-4">
                    <div id="currentTicket" class="mb-4">
                        <div class="display-1 fw-bold text-primary mb-3" id="currentTicketNumber">
                            ---
                        </div>
                        <div id="currentTicketStatus" class="mb-3">
                            <span class="badge bg-secondary fs-6">No Active Ticket</span>
                        </div>
                        <div class="text-muted small" id="ticketTimer"></div>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg" id="callNextBtn" disabled>
                            <i class="fas fa-bullhorn me-2"></i>Call Next Ticket
                        </button>
                        <button class="btn btn-info btn-lg" id="startServingBtn" disabled>
                            <i class="fas fa-handshake me-2"></i>Start Serving
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Queue & Actions -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users me-2"></i>Waiting Queue
                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="display-4 fw-bold text-info" id="waitingCount">
                            0
                        </div>
                        <div class="text-muted">Customers Waiting</div>
                    </div>

                    <div id="queueList" class="mb-4" style="max-height: 300px; overflow-y: auto;">
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-inbox fa-2x mb-2"></i>
                            <p>No customers waiting</p>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-success btn-lg" id="finishBtn" disabled>
                            <i class="fas fa-check-circle me-2"></i>Mark as Finished
                        </button>
                        <button class="btn btn-outline-danger btn-lg" id="noShowBtn" disabled>
                            <i class="fas fa-user-times me-2"></i>Mark as No Show
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-muted small mb-2">Today's Served</div>
                    <div class="h3 fw-bold text-primary" id="todayServed">0</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-muted small mb-2">Average Wait Time</div>
                    <div class="h3 fw-bold text-info" id="avgWaitTime">0 min</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-muted small mb-2">Service Point Status</div>
                    <button class="btn btn-lg w-100" id="toggleStatusBtn"
                            style="background-color: @(Model.ServicePointIsActive ? "#28a745" : "#dc3545"); color: white; border: none;"
                        @(!Model.ServicePointId.HasValue ? "disabled" : "")>
                        <i class="fas fa-power-off me-2"></i>
                        <span id="toggleStatusText">@(Model.ServicePointIsActive ? "GO OFFLINE" : "GO ONLINE")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // State management
        let currentTicket = null;
        let currentStatus = null;
        let isOnline = @(Model.ServicePointIsActive ? "true" : "false");
        let pollingInterval = null;
        let ticketTimerInterval = null;

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function () {
            console.log('Dashboard initialized');
            updateButtonStates();

            if (isOnline) {
                startPolling();
            }

            // Attach event listeners
            document.getElementById('toggleStatusBtn').addEventListener('click', toggleOnlineStatus);
            document.getElementById('callNextBtn').addEventListener('click', callNextTicket);
            document.getElementById('startServingBtn').addEventListener('click', startServing);
            document.getElementById('finishBtn').addEventListener('click', finishTicket);
            document.getElementById('noShowBtn').addEventListener('click', markAsNoShow);
        });

        // Polling function
        function startPolling() {
            console.log('Starting polling...');
            fetchQueue(); // Immediate fetch
            pollingInterval = setInterval(fetchQueue, 3000); // Every 3 seconds
        }

        function stopPolling() {
            console.log('Stopping polling...');
            if (pollingInterval) {
                clearInterval(pollingInterval);
                pollingInterval = null;
            }
        }

        // Fetch queue
        async function fetchQueue() {
            try {
                const response = await fetch('/Staff/GetQueue');
                const data = await response.json();

                if (data.error) {
                    console.error('Error fetching queue:', data.error);
                    return;
                }

                // Separate waiting tickets from active tickets
                const waitingTickets = data.tickets.filter(t => t.status === 'Waiting');
                const myActiveTickets = data.tickets.filter(t =>
                    t.status === 'Called' || t.status === 'Serving'
                );

                // Update waiting queue (ONLY waiting tickets)
                updateQueueDisplay(waitingTickets);

                // Update current ticket if I have one
                if (myActiveTickets.length > 0) {
                    currentTicket = myActiveTickets[0].ticketNumber;
                    currentStatus = myActiveTickets[0].status;
                    updateCurrentTicketDisplay();
                } else {
                    // No active ticket
                    currentTicket = null;
                    currentStatus = null;
                    updateCurrentTicketDisplay();
                }

                updateButtonStates();

            } catch (error) {
                console.error('Error fetching queue:', error);
            }
        }

        // Update queue display - ONLY shows waiting tickets
        function updateQueueDisplay(tickets) {
            const queueList = document.getElementById('queueList');
            const waitingCount = document.getElementById('waitingCount');

            // Filter to show ONLY waiting tickets
            const waitingTickets = tickets.filter(ticket => ticket.status === 'Waiting');
            waitingCount.textContent = waitingTickets.length;

            if (waitingTickets.length === 0) {
                queueList.innerHTML = `
                    <div class="text-center text-muted py-3">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <p>No customers waiting</p>
                    </div>
                `;
            } else {
                let html = '<div class="list-group">';
                waitingTickets.forEach((ticket, index) => {
                    const waitTime = getWaitTime(ticket.createdAt);
                    html += `
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-primary me-2">${index + 1}</span>
                                <strong>${ticket.ticketNumber}</strong>
                            </div>
                            <small class="text-muted">Waiting ${waitTime}</small>
                        </div>
                    `;
                });
                html += '</div>';
                queueList.innerHTML = html;
            }
        }

        // Calculate wait time
        function getWaitTime(createdAt) {
            const now = new Date();
            const created = new Date(createdAt);
            const diffMs = now - created;
            const diffMins = Math.floor(diffMs / 60000);

            if (diffMins < 1) return 'just now';
            if (diffMins === 1) return '1 min';
            return `${diffMins} mins`;
        }

        // Toggle online/offline status
        async function toggleOnlineStatus() {
            const btn = document.getElementById('toggleStatusBtn');
            const originalHtml = btn.innerHTML; // Save original HTML
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';

            try {
                const response = await fetch('/Staff/ToggleAvailability', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const data = await response.json();

                if (data.success) {
                    isOnline = data.isActive;

                    // Update button - rebuild entire HTML (don't try to find the span)
                    btn.innerHTML = `<i class="fas fa-power-off me-2"></i>${isOnline ? 'GO OFFLINE' : 'GO ONLINE'}`;

                    // CORRECT: Online = GREEN, Offline = RED
                    btn.style.backgroundColor = isOnline ? '#28a745' : '#dc3545';

                    // Start/stop polling
                    if (isOnline) {
                        startPolling();
                    } else {
                        stopPolling();
                        // Reset current ticket when going offline
                        clearCurrentTicket();
                    }

                    updateButtonStates();
                    showNotification(isOnline ? 'You are now ONLINE' : 'You are now OFFLINE', 'success');

                    // Reload page after 800ms to sync all elements
                    setTimeout(() => {
                        window.location.reload();
                    }, 800);
                } else {
                    // If API returns error, restore original button
                    btn.innerHTML = originalHtml;
                    showNotification('Failed to update status', 'error');
                }
            } catch (error) {
                console.error('Error toggling status:', error);
                // Restore original button on any error
                btn.innerHTML = originalHtml;
                showNotification('Failed to update status', 'error');
            } finally {
                btn.disabled = false;
            }
        }

        // Call next ticket
        async function callNextTicket() {
            const btn = document.getElementById('callNextBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Calling...';

            try {
                const response = await fetch('/Staff/CallNext', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const data = await response.json();

                if (data.success) {
                    currentTicket = data.ticketNumber;
                    currentStatus = 'Called';

                    updateCurrentTicketDisplay();
                    updateButtonStates();
                    fetchQueue(); // Refresh queue immediately

                    showNotification(`Called: ${currentTicket}`, 'success');
                } else {
                    showNotification(data.message || 'No tickets waiting', 'info');
                }
            } catch (error) {
                console.error('Error calling next:', error);
                showNotification('Failed to call next ticket', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-bullhorn me-2"></i>Call Next Ticket';
                updateButtonStates();
            }
        }

        // Start serving
        async function startServing() {
            if (!currentTicket) return;

            const btn = document.getElementById('startServingBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Starting...';

            try {
                const response = await fetch('/Staff/UpdateTicketStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        ticketNumber: currentTicket,
                        newStatus: 'Serving'
                    })
                });

                const data = await response.json();

                if (data.success) {
                    currentStatus = 'Serving';
                    updateCurrentTicketDisplay();
                    updateButtonStates();
                    fetchQueue(); // Refresh queue immediately
                    showNotification('Started serving customer', 'success');
                } else {
                    showNotification(data.message || 'Failed to update status', 'error');
                }
            } catch (error) {
                console.error('Error starting service:', error);
                showNotification('Failed to start serving', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-handshake me-2"></i>Start Serving';
                updateButtonStates();
            }
        }

        // Finish ticket
        async function finishTicket() {
            if (!currentTicket) return;

            const btn = document.getElementById('finishBtn');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Finishing...';

            try {
                const response = await fetch('/Staff/UpdateTicketStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        ticketNumber: currentTicket,
                        newStatus: 'Finished'
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(`Ticket ${currentTicket} completed!`, 'success');
                    clearCurrentTicket();
                    fetchQueue(); // Refresh queue
                } else {
                    showNotification(data.message || 'Failed to finish ticket', 'error');
                }
            } catch (error) {
                console.error('Error finishing ticket:', error);
                showNotification('Failed to finish ticket', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                updateButtonStates();
            }
        }

        // Mark as no show
        async function markAsNoShow() {
            if (!currentTicket) return;

            // Show confirmation
            if (!confirm(`Are you sure you want to mark ${currentTicket} as NO SHOW?\n\nThis customer will not be served.`)) {
                return;
            }

            const btn = document.getElementById('noShowBtn');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';

            try {
                const response = await fetch('/Staff/UpdateTicketStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        ticketNumber: currentTicket,
                        newStatus: 'NoShow'
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(`Ticket ${currentTicket} marked as No Show`, 'warning');
                    clearCurrentTicket();
                    fetchQueue(); // Refresh queue
                } else {
                    showNotification(data.message || 'Failed to mark as no show', 'error');
                }
            } catch (error) {
                console.error('Error marking no show:', error);
                showNotification('Failed to mark as no show', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                updateButtonStates();
            }
        }

        // Update current ticket display
        function updateCurrentTicketDisplay() {
            const ticketNumber = document.getElementById('currentTicketNumber');
            const ticketStatus = document.getElementById('currentTicketStatus');

            if (currentTicket) {
                ticketNumber.textContent = currentTicket;

                let badgeClass = 'bg-secondary';
                let statusText = 'Unknown';

                if (currentStatus === 'Called') {
                    badgeClass = 'bg-warning';
                    statusText = 'Called - Waiting for Customer';
                } else if (currentStatus === 'Serving') {
                    badgeClass = 'bg-success';
                    statusText = 'Currently Serving';
                }

                ticketStatus.innerHTML = `<span class="badge ${badgeClass} fs-6">${statusText}</span>`;
            } else {
                ticketNumber.textContent = '---';
                ticketStatus.innerHTML = `<span class="badge bg-secondary fs-6">No Active Ticket</span>`;
            }
        }

        // Clear current ticket
        function clearCurrentTicket() {
            currentTicket = null;
            currentStatus = null;
            updateCurrentTicketDisplay();
            updateButtonStates();
        }

        // Update button states based on current state
        function updateButtonStates() {
            const callNextBtn = document.getElementById('callNextBtn');
            const startServingBtn = document.getElementById('startServingBtn');
            const finishBtn = document.getElementById('finishBtn');
            const noShowBtn = document.getElementById('noShowBtn');

            // Default: disable all action buttons
            callNextBtn.disabled = true;
            startServingBtn.disabled = true;
            finishBtn.disabled = true;
            noShowBtn.disabled = true;

            // If offline, only Call Next can be enabled (but it won't work until online)
            if (!isOnline) {
                return;
            }

            // Online and no current ticket - can call next
            if (!currentTicket) {
                callNextBtn.disabled = false;
            }
            // Has ticket in "Called" status
            else if (currentStatus === 'Called') {
                startServingBtn.disabled = false; // Can start serving
                noShowBtn.disabled = false; // Can mark as no show
            }
            // Has ticket in "Serving" status
            else if (currentStatus === 'Serving') {
                finishBtn.disabled = false; // Can finish
                noShowBtn.disabled = true; // CANNOT mark as no show while serving
            }
        }

        // Show notification
        function showNotification(message, type = 'info') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show position-fixed`;
            alertDiv.style.cssText = 'top: 80px; right: 20px; z-index: 9999; min-width: 300px;';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);

            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }

        // Cleanup on page unload
        window.addEventListener('beforeunload', function () {
            stopPolling();
            if (ticketTimerInterval) {
                clearInterval(ticketTimerInterval);
            }
        });
    </script>
}